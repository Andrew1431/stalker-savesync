--[[
  stalker-savesync: lets anyone in the group host a co-op save.

  xrRazom keeps every client's character in <save>.xrr_peers (keyed by xrRazom
  player name), but the host's own character only exists inside the save as the
  actor, whose character name is the host's xrRazom name.

  When you load a save someone else hosted and your name is in its .xrr_peers:
  - the inherited actor (the old host's character) is turned into a client
    record under their name,
  - your record is applied to the actor, so you play your own character,
  - the game saves and reloads once, which writes the old host's record into
    .xrr_peers (xrRazom only reads that file on load), so they can join with
    their own character.
  On every save the host's own stale record is dropped from .xrr_peers.
  Record format: docs/xrr_peers-format.md.
]]

local MAX_DEPTH = 8  -- same table depth limit xrRazom's codecs use

-- Slots as numbered in xrRazom's records.
local SLOT_OUTFIT, SLOT_PDA, SLOT_HELMET = 7, 8, 12
local PLACE_SLOT, PLACE_BELT, PLACE_RUCK = 1, 2, 3
local LIMBS = { "head", "leftarm", "leftleg", "rightarm", "rightleg", "torso" }

------------------------------------------------------------------ binary writer

local floor, frexp, char = math.floor, math.frexp, string.char

local W = {}
W.__index = W

function W.new() return setmetatable({ buf = {} }, W) end
function W:bytes() return table.concat(self.buf) end
function W:raw(s) self.buf[#self.buf + 1] = s end

function W:uint(v, n)
	v = floor(v)
	local t = {}
	for i = 1, n do
		t[i] = v % 256
		v = floor(v / 256)
	end
	self:raw(char(unpack(t)))
end

function W:u8(v)  self:uint(v, 1) end
function W:u16(v) self:uint(v, 2) end
function W:u32(v) self:uint(v, 4) end
function W:i32(v) self:uint(v < 0 and v + 4294967296 or v, 4) end
function W:u64(v) self:uint(v, 8) end  -- exact up to 2^53; SteamIDs are filled in by the DLL

-- IEEE 754 encode; bits = 32 or 64.
local function pack_float(x, bits)
	local ebits, mbits = bits == 32 and 8 or 11, bits == 32 and 23 or 52
	local bias = 2 ^ (ebits - 1) - 1
	local sign = (x < 0 or 1 / x < 0) and 1 or 0
	x = math.abs(x)
	local e, m
	if x ~= x then
		e, m = 2 ^ ebits - 1, 1
	elseif x == math.huge then
		e, m = 2 ^ ebits - 1, 0
	elseif x == 0 then
		e, m = 0, 0
	else
		local fm, fe = frexp(x)  -- x = fm * 2^fe, fm in [0.5, 1)
		e = fe - 1 + bias
		if e <= 0 then  -- subnormal
			m = floor(x / 2 ^ (1 - bias - mbits) + 0.5)
			e = 0
		else
			m = floor((fm * 2 - 1) * 2 ^ mbits + 0.5)
			if m == 2 ^ mbits then m, e = 0, e + 1 end
			if e >= 2 ^ ebits - 1 then e, m = 2 ^ ebits - 1, 0 end
		end
	end
	return sign, e, m, mbits
end

function W:f32(x)
	local s, e, m = pack_float(x, 32)
	self:u32(s * 2 ^ 31 + e * 2 ^ 23 + m)
end

function W:f64(x)
	local s, e, m = pack_float(x, 64)
	self:u32(m % 2 ^ 32)
	self:u32(s * 2 ^ 31 + e * 2 ^ 20 + floor(m / 2 ^ 32))
end

function W:cstr(s) self:raw(s) self:raw("\0") end
function W:lstr(s) self:u16(#s) self:raw(s) end

-- Typed value: 01 bool, 02 f64, 03 string, 04 table of typed pairs.
-- Tables are given as { table = { {k, v}, ... } } so order is preserved.
function W:value(v)
	local t = type(v)
	if t == "boolean" then
		self:u8(1) self:u8(v and 1 or 0)
	elseif t == "number" then
		self:u8(2) self:f64(v)
	elseif t == "string" then
		self:u8(3) self:lstr(v)
	else
		self:u8(4) self:u16(#v.table)
		for _, kv in ipairs(v.table) do
			self:value(kv[1])
			self:value(kv[2])
		end
	end
end

-- cstr key, u16 byte length, typed value
function W:sized(key, v)
	local inner = W.new()
	inner:value(v)
	local b = inner:bytes()
	self:cstr(key)
	self:u16(#b)
	self:raw(b)
end

------------------------------------------------------------------ record encoder

-- `p` uses the same field names as tools/xrr_peers.py's JSON.
function encode_peer(p)
	local w = W.new()
	w:cstr(p.name)
	w:u64(p.steamid)
	w:cstr(p.faction)
	w:cstr(p.visual)
	w:cstr(p.outfit)
	w:cstr(p.helmet)
	w:cstr(p.pda)
	w:cstr(p.torch)
	w:cstr(p.active_weapon)
	w:u32(p.active_slot)
	w:cstr(p.level)
	for i = 1, 3 do w:f32(p.position[i]) end
	for i = 1, 2 do w:f32(p.unk_angles[i]) end
	w:f32(p.health)
	w:u32(p.unk_u32)
	w:u32(p.money)
	for i = 1, 4 do w:cstr(p.quick_slots[i]) end
	w:u8(p.unk_u8)

	w:u16(#p.items)
	for _, it in ipairs(p.items) do
		w:u32(it.id)
		w:cstr(it.section)
		w:u16(it.count)
		w:f32(it.condition)
		w:u32(it.ammo_in_mag)
		w:u8(it.slot)
		w:u8(it.place)
		w:u8(it.uses)
		w:u8(#it.upgrades)
		for _, u in ipairs(it.upgrades) do w:cstr(u) end
		if it.data then
			local inner = W.new()
			inner:u16(#it.data)
			for _, kv in ipairs(it.data) do
				inner:lstr(kv[1])
				inner:value(kv[2])
			end
			local b = inner:bytes()
			w:u8(1) w:u16(#b) w:raw(b)
		else
			w:u8(0)
		end
		w:u16(it.unk_tail)
	end

	w:i32(p.reputation)
	w:i32(p.rank)
	w:u16(#p.faction_goodwill)
	for _, g in ipairs(p.faction_goodwill) do w:u8(g[1]) w:i32(g[2]) end
	w:u16(#p.npc_relations)
	for _, g in ipairs(p.npc_relations) do w:u16(g[1]) w:i32(g[2]) end

	w:cstr(p.stats)
	w:cstr(p.needs)
	w:u8(p.unk_u8_flags)
	w:u16(#p.flags)
	for _, kv in ipairs(p.flags) do w:cstr(kv[1]) w:cstr(kv[2]) end
	w:u16(#p.pstor)
	for _, kv in ipairs(p.pstor) do w:sized(kv[1], kv[2]) end
	w:u16(#p.m_data)
	for _, kv in ipairs(p.m_data) do w:sized(kv[1], kv[2]) end
	w:u64(p.game_times[1])
	w:u64(p.game_times[2])
	return w:bytes()
end

------------------------------------------------------------------ record decoder

local byte, ldexp = string.byte, math.ldexp

local R = {}
R.__index = R

function R.new(s, pos) return setmetatable({ s = s, p = pos or 1 }, R) end

function R:uint(n)
	local v, mul = 0, 1
	for i = 0, n - 1 do
		v = v + byte(self.s, self.p + i) * mul
		mul = mul * 256
	end
	self.p = self.p + n
	return v
end

function R:u8()  return self:uint(1) end
function R:u16() return self:uint(2) end
function R:u32() return self:uint(4) end
function R:i32() local v = self:uint(4) return v >= 2147483648 and v - 4294967296 or v end
function R:u64() return self:uint(8) end  -- lossy above 2^53; only used for ids we don't need

local function unpack_float(lo, hi, bits)
	local ebits, mbits = bits == 32 and 8 or 11, bits == 32 and 23 or 52
	local bias = 2 ^ (ebits - 1) - 1
	local word = bits == 32 and lo or hi
	local sign = word >= 2 ^ 31 and -1 or 1
	local top = word % 2 ^ 31
	local e, m
	if bits == 32 then
		e, m = floor(top / 2 ^ 23), top % 2 ^ 23
	else
		e, m = floor(top / 2 ^ 20), (top % 2 ^ 20) * 2 ^ 32 + lo
	end
	if e == 0 then
		if m == 0 then return sign * 0.0 end
		return sign * ldexp(m, 1 - bias - mbits)
	end
	if e == 2 ^ ebits - 1 then
		if m == 0 then return sign * math.huge end
		return 0 / 0
	end
	return sign * ldexp(1 + m / 2 ^ mbits, e - bias)
end

function R:f32() return unpack_float(self:u32(), 0, 32) end
function R:f64() local lo = self:u32() return unpack_float(lo, self:u32(), 64) end

function R:cstr()
	local e = self.s:find("\0", self.p, true)
	local v = self.s:sub(self.p, e - 1)
	self.p = e + 1
	return v
end

function R:lstr()
	local n = self:u16()
	local v = self.s:sub(self.p, self.p + n - 1)
	self.p = self.p + n
	return v
end

function R:value()
	local t = self:u8()
	if t == 1 then return self:u8() ~= 0 end
	if t == 2 then return self:f64() end
	if t == 3 then return self:lstr() end
	if t == 4 then
		local out = {}
		for i = 1, self:u16() do
			local k = self:value()
			out[i] = { k, self:value() }
		end
		return { table = out }
	end
	error("unknown value type " .. t)
end

function R:sized()
	local key = self:cstr()
	local n = self:u16()
	local start = self.p
	local v = self:value()
	assert(self.p == start + n, "sized value length mismatch for " .. key)
	return { key, v }
end

-- Inverse of encode_peer; returns the record and the position after it.
function decode_peer(s, pos)
	local r = R.new(s, pos)
	local p = {}
	p.name = r:cstr()
	p.steamid = r:u64()
	p.faction = r:cstr()
	p.visual = r:cstr()
	p.outfit = r:cstr()
	p.helmet = r:cstr()
	p.pda = r:cstr()
	p.torch = r:cstr()
	p.active_weapon = r:cstr()
	p.active_slot = r:u32()
	p.level = r:cstr()
	p.position = { r:f32(), r:f32(), r:f32() }
	p.unk_angles = { r:f32(), r:f32() }
	p.health = r:f32()
	p.unk_u32 = r:u32()
	p.money = r:u32()
	p.quick_slots = { r:cstr(), r:cstr(), r:cstr(), r:cstr() }
	p.unk_u8 = r:u8()

	p.items = {}
	for i = 1, r:u16() do
		local it = {}
		it.id = r:u32()
		it.section = r:cstr()
		it.count = r:u16()
		it.condition = r:f32()
		it.ammo_in_mag = r:u32()
		it.slot = r:u8()
		it.place = r:u8()
		it.uses = r:u8()
		it.upgrades = {}
		for j = 1, r:u8() do it.upgrades[j] = r:cstr() end
		if r:u8() ~= 0 then
			local n = r:u16()
			local start = r.p
			it.data = {}
			for j = 1, r:u16() do
				local k = r:lstr()
				it.data[j] = { k, r:value() }
			end
			assert(r.p == start + n, "item data length mismatch for " .. it.section)
		end
		it.unk_tail = r:u16()
		p.items[i] = it
	end

	p.reputation = r:i32()
	p.rank = r:i32()
	p.faction_goodwill = {}
	for i = 1, r:u16() do p.faction_goodwill[i] = { r:u8(), r:i32() } end
	p.npc_relations = {}
	for i = 1, r:u16() do p.npc_relations[i] = { r:u16(), r:i32() } end
	p.stats = r:cstr()
	p.needs = r:cstr()
	p.unk_u8_flags = r:u8()
	p.flags = {}
	for i = 1, r:u16() do p.flags[i] = { r:cstr(), r:cstr() } end
	p.pstor = {}
	for i = 1, r:u16() do p.pstor[i] = r:sized() end
	p.m_data = {}
	for i = 1, r:u16() do p.m_data[i] = r:sized() end
	p.game_times = { r:u64(), r:u64() }
	return p, r.p
end

-- Typed form -> native Lua value.
function to_native(v)
	if type(v) ~= "table" then return v end
	local out = {}
	for _, kv in ipairs(v.table) do out[to_native(kv[1])] = to_native(kv[2]) end
	return out
end

------------------------------------------------------------------ collecting the live actor

-- Native Lua value -> typed form; nil for anything the format can't hold.
local function to_typed(v, depth)
	local t = type(v)
	if t == "boolean" or t == "number" or t == "string" then return v end
	if t == "userdata" and utils_data and utils_data.CTime_to_table then
		local ok, tbl = pcall(utils_data.CTime_to_table, v)
		if ok and tbl then
			return { table = { { "__xrr_ctime", to_typed(tbl, MAX_DEPTH) } } }
		end
		return nil
	end
	if t ~= "table" or depth <= 0 then return nil end
	local out = {}
	for k, sub in pairs(v) do
		local tk, tv = to_typed(k, 0), to_typed(sub, depth - 1)
		if tk ~= nil and tv ~= nil and type(k) ~= "table" then
			out[#out + 1] = { tk, tv }
		end
	end
	return { table = out }
end

local function section_in_slot(slot)
	local item = db.actor:item_in_slot(slot)
	return item and item:section() or ""
end

local function community_indices()
	-- game_relations.communities is "name, index, name, index, ..."
	local map = {}
	local list = ini_sys:r_string_ex("game_relations", "communities") or ""
	local name
	for tok in list:gmatch("[^,%s]+") do
		if name then
			map[name] = tonumber(tok)
			name = nil
		else
			name = tok
		end
	end
	return map
end

local function collect_item(item, slots, mdata_keys, m)
	local id = item:id()
	local place, slot = PLACE_RUCK, 0
	if slots[id] then
		place, slot = PLACE_SLOT, slots[id]
	elseif db.actor:is_on_belt(item) then
		place = PLACE_BELT
	end

	local count = 1
	if IsAmmo(item) then count = item:ammo_get_count() end

	-- xrRazom packs rounds in the low 16 bits and the loaded ammo type above them.
	local mag = 0
	if IsWeapon(item) and not IsMelee(item) and item.get_ammo_in_magazine then
		mag = (item:get_ammo_in_magazine() or 0) % 65536
		if item.get_ammo_type then mag = mag + (item:get_ammo_type() or 0) * 65536 end
	end

	local uses = 0
	if item.get_remaining_uses then
		local ok, n = pcall(item.get_remaining_uses, item)
		if ok and n then uses = n end
	end

	-- Per-item m_data riders xrRazom declares (xrr_item_mdata.manifest).
	local riders = {}
	for _, key in ipairs(mdata_keys) do
		local tbl = m[key]
		if type(tbl) == "table" and tbl[id] ~= nil then
			local v = to_typed(tbl[id], MAX_DEPTH)
			if v ~= nil then riders[#riders + 1] = { key, v } end
		end
	end
	local data = {}
	local parts = se_load_var and se_load_var(id, nil, "parts")
	if type(parts) == "table" then data[#data + 1] = { "parts", to_typed(parts, MAX_DEPTH) } end
	data[#data + 1] = { "m_data", { table = riders } }

	local upgrades = {}
	if item.iterate_installed_upgrades then
		item:iterate_installed_upgrades(function(u) upgrades[#upgrades + 1] = u end)
	end

	return {
		id = id, section = item:section(), count = count, condition = item:condition(),
		ammo_in_mag = mag, slot = slot, place = place, uses = uses, upgrades = upgrades,
		data = data, unk_tail = 0,
	}
end

-- name: the xrRazom name to record this character under.
function collect_peer(name)
	local actor = db.actor
	local m = alife_storage_manager.get_state()

	local slots = {}
	for s = 1, 13 do
		local item = actor:item_in_slot(s)
		if item then slots[item:id()] = s end
	end

	local item_keys = {}
	if xrr_item_mdata and xrr_item_mdata.manifest then
		for _, d in ipairs(xrr_item_mdata.manifest) do item_keys[#item_keys + 1] = d.key end
	end
	local items = {}
	actor:iterate_inventory(function(_, item)
		-- GAMMA's slot-10 dummy torch isn't a real item; xrRazom leaves it out.
		if item:section() ~= "device_torch_dummy" then
			items[#items + 1] = collect_item(item, slots, item_keys, m)
		end
	end, actor)

	local goodwill = {}
	local idx = community_indices()
	for comm, i in pairs(idx) do
		local gw = relation_registry.community_goodwill(comm, actor:id())
		if gw and gw ~= 0 then goodwill[#goodwill + 1] = { i, gw } end
	end
	table.sort(goodwill, function(a, b) return a[1] < b[1] end)

	-- The actor's pstor (save_var store): limb health, drug timers, counters...
	local pstor = {}
	local src = xrr_get_actor_pstor and xrr_get_actor_pstor()
	if type(src) == "table" then
		for k, v in pairs(src) do
			local tv = type(k) == "string" and to_typed(v, MAX_DEPTH) or nil
			if tv ~= nil then pstor[#pstor + 1] = { k, tv } end
		end
		table.sort(pstor, function(a, b) return a[1] < b[1] end)
	end

	-- Peer-owned m_data keys, as xrRazom carries them (xrr_peer_mdata.manifest).
	SendScriptCallback("save_state", m)
	local mdata = {}
	if xrr_peer_mdata and xrr_peer_mdata.manifest then
		for _, key in ipairs(xrr_peer_mdata.manifest) do
			local v = m[key]
			local subs = xrr_peer_mdata.sub_filter and xrr_peer_mdata.sub_filter[key]
			if v ~= nil and subs and type(v) == "table" then
				local f = {}
				for _, sk in ipairs(subs) do f[sk] = v[sk] end
				v = f
			end
			local tv = v ~= nil and to_typed(v, MAX_DEPTH) or nil
			if tv ~= nil then mdata[#mdata + 1] = { key, tv } end
		end
		table.sort(mdata, function(a, b) return a[1] < b[1] end)
	end

	local visual = actor:get_visual_name() or ""
	if visual ~= "" and not visual:find("%.ogf$") then visual = visual .. ".ogf" end

	local active = actor:active_item()
	local pos = actor:position()
	local heading = actor:direction():getH()

	return {
		name = name,
		steamid = 0,  -- filled in by savesync.dll
		faction = get_actor_true_community(),
		visual = visual,
		outfit = section_in_slot(SLOT_OUTFIT),
		helmet = section_in_slot(SLOT_HELMET),
		pda = section_in_slot(SLOT_PDA),
		torch = actor:object("device_torch") and "device_torch" or "",
		active_weapon = active and active:section() or "",
		active_slot = actor:active_slot(),
		level = level.name(),
		position = { pos.x, pos.y, pos.z },
		unk_angles = { heading, heading },
		health = actor.health,
		unk_u32 = 0,
		money = actor:money(),
		quick_slots = {
			get_console_cmd(0, "slot_0") or "", get_console_cmd(0, "slot_1") or "",
			get_console_cmd(0, "slot_2") or "", get_console_cmd(0, "slot_3") or "",
		},
		unk_u8 = 1,
		items = items,
		reputation = actor:character_reputation(),
		rank = actor:character_rank(),
		faction_goodwill = goodwill,
		npc_relations = {},
		stats = xrr_net_client and xrr_net_client.xrr_collect_stats_blob() or "",
		needs = xrr_net_client and xrr_net_client.xrr_collect_condition_blob() or "",
		unk_u8_flags = 0,
		flags = {},
		pstor = pstor,
		m_data = mdata,
		game_times = { 0, 0 },  -- filled in by savesync.dll from the other records
	}
end

------------------------------------------------------------------ save file plumbing

local PEERS_VERSION = 15
local LOADING_FILE = "savesync_loading.txt"

local function my_name()
	return get_console_cmd(0, "xrr_player_name") or ""
end

local function saves_dir()
	return getFS():update_path("$game_saves$", "")
end

local function app_path(name)
	return getFS():update_path("$app_data_root$", "") .. name
end

local function read_file(path)
	local f = io.open(path, "rb")
	if not f then return nil end
	local s = f:read("*a")
	f:close()
	return s
end

local function write_file(path, data)
	local f = io.open(path, "wb")
	if not f then return false end
	f:write(data)
	f:close()
	return true
end

local function log(fmt, ...)
	printf("[savesync] " .. fmt, ...)
end

-- Newest save (by .scop time) as { name, modif }.
local function newest_save()
	local list = getFS():file_list_open_ex("$game_saves$", bit_or(FS.FS_ListFiles, FS.FS_RootOnly), "*.scop")
	local best
	for i = 0, list:Size() - 1 do
		local f = list:GetAt(i)
		local modif = tonumber(f:Modif()) or 0 -- the engine hands it over as a string
		if not best or modif > best.modif then
			best = { name = (f:NameFull():gsub("%.scop$", "")), modif = modif }
		end
	end
	return best
end

-- .xrr_peers -> list of { name, raw, record }; nil + error if it isn't a v15 file.
-- A missing file is an empty list.
function read_peers_string(s)
	if not s then return {} end
	if s:sub(1, 4) ~= "XPRR" then return nil, "not an .xrr_peers file" end
	local r = R.new(s, 5)
	local version, count = r:u32(), r:u32()
	if version ~= PEERS_VERSION then return nil, "unsupported .xrr_peers version " .. version end
	local out, pos = {}, r.p
	for i = 1, count do
		local p, next_pos = decode_peer(s, pos)
		out[i] = { name = p.name, raw = s:sub(pos, next_pos - 1), record = p }
		pos = next_pos
	end
	return out
end

function peers_bytes(peers)
	local w = W.new()
	w:raw("XPRR")
	w:u32(PEERS_VERSION)
	w:u32(#peers)
	for _, p in ipairs(peers) do w:raw(p.raw) end
	return w:bytes()
end

------------------------------------------------------------------ on save: keep .xrr_peers right

local saving_name   -- from the "save <name>" console command, if we saw it
local captured = {} -- old hosts' characters taken over this session: name -> record bytes

-- Returns peers file bytes with `me` (the host, who doesn't belong there) removed
-- and each record in `add` (name -> bytes) inserted, replacing same-name ones.
-- SteamID and game times can't round-trip a Lua number, so they're copied as raw
-- bytes from records already in the file.
function patched_peers(s, me, add)
	local peers, err = read_peers_string(s)
	if not peers then return nil, err end
	local steamids, times = {}, nil
	local out = {}
	for _, p in ipairs(peers) do
		steamids[p.name] = p.raw:sub(#p.name + 2, #p.name + 9)
		if p.name ~= me and not add[p.name] then
			times = times or p.raw:sub(-16)
			out[#out + 1] = p
		end
	end
	local names = {}
	for name in pairs(add) do names[#names + 1] = name end
	table.sort(names)
	for _, name in ipairs(names) do
		local rec, n = add[name], #name + 1
		local raw = rec:sub(1, n) .. (steamids[name] or string.rep("\0", 8)) .. rec:sub(n + 9)
		if times then raw = raw:sub(1, -17) .. times end
		out[#out + 1] = { name = name, raw = raw }
	end
	return peers_bytes(out), #out
end

local function patch_save(path, me)
	local data, n = patched_peers(read_file(path), me, captured)
	if not data then
		printe("![savesync] not touching %s: %s", path, tostring(n))
		return
	end
	if write_file(path, data) then log("updated %s (%s players)", path, n) end
end

local function on_save_state()
	if not db.actor then return end
	if XrrIsClient and XrrIsClient() then return end
	local me = my_name()
	if me == "" then return end

	-- The engine and xrRazom write the files after this callback; patch once the
	-- save is on disk.
	local started, tries = os.time(), 0
	local function step()
		tries = tries + 1
		local name = saving_name
		if not name then
			local newest = newest_save()
			if newest and newest.modif >= started - 2 then name = newest.name end
		end
		local base = name and saves_dir() .. name
		if not (base and getFS():exist(base .. ".scop")) and tries < 10 then return false end
		if base then
			local ok, err = pcall(patch_save, base .. ".xrr_peers", me)
			if not ok then printe("![savesync] updating .xrr_peers failed: %s", tostring(err)) end
		end
		saving_name = nil
		return true
	end
	CreateTimeEvent("savesync", "patch_save", 1, function()
		local ok, done = pcall(step)
		if not ok then
			printe("![savesync] after-save check failed: %s", tostring(done))
			saving_name = nil
			return true
		end
		return done
	end)
end

------------------------------------------------------------------ on load: take over the character

-- Position is not applied: the new host stays where the old host saved.

local function step(name, fn)
	local ok, err = pcall(fn)
	if not ok then printe("![savesync] apply step '%s' failed: %s", name, tostring(err)) end
	return ok
end

local function finish_items(pending)
	local left = 0
	for id, it in pairs(pending) do
		local obj = level.object_by_id(id)
		if obj then
			step("item " .. it.section, function()
				for _, u in ipairs(it.upgrades) do obj:install_upgrade(u) end
				-- Parts-based items recompute condition on spawn; put ours back.
				obj:set_condition(it.condition)
				if it.ammo_in_mag > 0 and IsWeapon(obj) then
					obj:set_ammo_type(floor(it.ammo_in_mag / 65536))
					obj:set_ammo_elapsed(it.ammo_in_mag % 65536)
				end
				if it.place == PLACE_SLOT and it.slot > 0 then
					db.actor:move_to_slot(obj, it.slot)
				elseif it.place == PLACE_BELT then
					db.actor:move_to_belt(obj)
				end
			end)
			pending[id] = nil
		else
			left = left + 1
		end
	end
	return left
end

local function apply_items(p, on_done)
	local m = alife_storage_manager.get_state()
	local old = {}
	db.actor:iterate_inventory(function(_, item)
		if item:section() ~= "device_torch_dummy" then old[#old + 1] = item:id() end
	end, db.actor)
	for _, id in ipairs(old) do alife_release_id(id) end
	log("removed %s inherited items", #old)

	local pending, spawned = {}, 0
	for _, it in ipairs(p.items) do
		step("spawn " .. it.section, function()
			local t = { cond = it.condition }
			if it.uses > 0 then t.uses = it.uses end
			if it.section:find("^ammo_") then t.ammo = it.count end
			local se = alife_create_item(it.section, db.actor, t)
			-- Ammo comes back as a list of boxes rather than one server object.
			if type(se) == "table" and not se.id then se = se[1] end
			if not se then error("alife_create_item returned nil") end
			spawned = spawned + 1
			for _, kv in ipairs(it.data or {}) do
				if kv[1] == "parts" then
					se_save_var(se.id, se:name(), "parts", to_native(kv[2]))
				elseif kv[1] == "m_data" then
					for _, rider in ipairs(kv[2].table) do
						local key = rider[1]
						m[key] = m[key] or {}
						m[key][se.id] = to_native(rider[2])
					end
				end
			end
			pending[se.id] = it
		end)
	end
	log("spawned %s of %s items", spawned, #p.items)

	-- Upgrades, condition, magazines and slots need the items online.
	local tries = 0
	CreateTimeEvent("savesync", "finish_items", 1, function()
		tries = tries + 1
		local left = finish_items(pending)
		if left == 0 or tries >= 15 then
			if left > 0 then printe("![savesync] %s items never came online", left) end
			log("items done")
			if on_done then on_done() end
			return true
		end
		return false
	end)
end

local function apply_character(p)
	local actor = db.actor
	step("money", function() actor:give_money(p.money - actor:money()) end)
	step("rank", function() actor:set_character_rank(p.rank) end)
	step("reputation", function() actor:set_character_reputation(p.reputation) end)
	step("faction", function()
		if p.faction ~= "" and p.faction ~= get_actor_true_community() then
			actor:set_character_community("actor_" .. p.faction, 0, 0)
		end
	end)
	step("goodwill", function()
		local by_index = {}
		for _, g in ipairs(p.faction_goodwill) do by_index[g[1]] = g[2] end
		for comm, i in pairs(community_indices()) do
			relation_registry.set_community_goodwill(comm, actor:id(), by_index[i] or 0)
		end
	end)
	step("quick slots", function()
		for i = 1, 4 do exec_console_cmd("slot_" .. (i - 1) .. " " .. p.quick_slots[i]) end
	end)
	step("health", function()
		if actor.set_health_ex then actor:set_health_ex(p.health) end
	end)
	step("pstor", function()
		local vals = {}
		for _, kv in ipairs(p.pstor) do
			vals[kv[1]] = to_native(kv[2])
			utils_obj.save_var(actor, kv[1], vals[kv[1]])
		end
		-- Body Health System keeps limb health in module tables and saves them back
		-- over pstor, so update those too (same keys its LoadHealthStatus reads).
		local bhs = zzz_player_injuries
		if bhs and bhs.health and bhs.timedhp then
			for _, limb in ipairs(LIMBS) do
				if vals["health." .. limb] then bhs.health[limb] = vals["health." .. limb] end
				if vals["timedhp." .. limb] then bhs.timedhp[limb] = vals["timedhp." .. limb] end
			end
		end
	end)
	if xrr_net_client then
		step("stats", function() xrr_net_client.OnPeerStatsRestore(p.stats) end)
		step("needs", function() xrr_net_client.OnPeerConditionRestore(p.needs) end)
		step("progress", function() xrr_net_client.OnPeerProgressRestore() end)
	end
	step("m_data", function()
		local surrogate = {}
		for _, kv in ipairs(p.m_data) do surrogate[kv[1]] = to_native(kv[2]) end
		xrr_peer_mdata_apply(surrogate)
	end)
end

local function load_save(name)
	exec_console_cmd("load " .. name)
end

-- Take over a save someone else hosted. The save's character name is its host's
-- xrRazom name (xrRazom renames the actor to the host's nickname on every load,
-- a moment after this runs).
local function try_take_over(owner)
	local me = my_name()
	if me == "" or owner == "" or owner == me then return end

	-- Which save was loaded: remembered from "load <name>", else the newest.
	local name = read_file(app_path(LOADING_FILE))
	write_file(app_path(LOADING_FILE), "")
	if not name or name == "" then
		local newest = newest_save()
		name = newest and newest.name
	end
	if not name then return end

	local path = saves_dir() .. name .. ".xrr_peers"
	local peers, err = read_peers_string(read_file(path))
	if not peers then
		printe("![savesync] can't read %s: %s", path, tostring(err))
		return
	end
	local mine
	for _, p in ipairs(peers) do
		if p.name == me then mine = p.record end
	end
	if not mine then
		log("'%s' hosted %s and you aren't in it; playing as their character", owner, name)
		return
	end

	-- Keep the old host's character as a client record before replacing it.
	captured[owner] = encode_peer(collect_peer(owner))
	log("taking over %s from '%s' (your character: %s items, money %s, rank %s)",
		name, owner, #mine.items, mine.money, mine.rank)
	apply_character(mine)
	apply_items(mine, function()
		-- xrRazom only reads .xrr_peers on load, so save (which writes the old
		-- host's record into it) and load once more before anyone joins.
		log("saving and reloading so '%s' can rejoin with their character", owner)
		exec_console_cmd("save " .. name)
		CreateTimeEvent("savesync", "reload", 3, function()
			load_save(name)
			return true
		end)
	end)
end

local function on_first_update()
	if XrrIsClient and XrrIsClient() then return end
	-- Read before xrRazom renames the actor to our nickname.
	local owner = db.actor:character_name() or ""
	-- Let other mods finish their own first-update work first.
	CreateTimeEvent("savesync", "take_over", 2, function()
		local ok, err = pcall(try_take_over, owner)
		if not ok then printe("![savesync] take over failed: %s", tostring(err)) end
		return true
	end)
end

local function on_console_execute(name, ...)
	local arg = table.concat({ ... }, " ")
	if name == "save" and arg ~= "" then
		saving_name = arg
	elseif name == "load" and arg ~= "" then
		-- Lua restarts on load, so remember the name on disk.
		write_file(app_path(LOADING_FILE), arg)
	end
end

function on_game_start()
	RegisterScriptCallback("save_state", on_save_state)
	RegisterScriptCallback("actor_on_first_update", on_first_update)
	RegisterScriptCallback("on_console_execute", on_console_execute)
end

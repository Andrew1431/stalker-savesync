--[[
  stalker-savesync: host character export.

  xrRazom keeps every client's character in <save>.xrr_peers, but the host's own
  character only exists inside the .scop. To let someone else host a save later,
  the host's character is written out on every save in the same record format
  xrRazom uses for clients (.xrr_peers v15, see docs/xrr_peers-format.md).

  On save_state the host writes appdata/savesync_host.bin:
      "SSHX" u32 format, lstr save id, peer record
  and stamps the same id into m_data.savesync_id, so a loaded save can be
  matched back to its export. savesync.dll attaches the file to the save it
  ships to other players.
]]

local EXPORT_FORMAT = 1
local EXPORT_FILE = "savesync_host.bin"
local MAX_DEPTH = 8  -- same table depth limit xrRazom's codecs use

-- Slots as numbered in xrRazom's records.
local SLOT_OUTFIT, SLOT_PDA, SLOT_TORCH, SLOT_HELMET = 7, 8, 10, 12
local PLACE_SLOT, PLACE_BELT, PLACE_RUCK = 1, 2, 3
local LIMBS = { "head", "leftarm", "leftleg", "rightarm", "rightleg", "torso" }

------------------------------------------------------------------ binary writer

local floor, frexp, char = math.floor, math.frexp, string.char

local W = {}
W.__index = W

function W.new() return setmetatable({ buf = {} }, W) end
function W:bytes() return table.concat(self.buf) end
function W:raw(s) self.buf[#self.buf + 1] = s end

function W:uint(v, n)
	v = floor(v)
	local t = {}
	for i = 1, n do
		t[i] = v % 256
		v = floor(v / 256)
	end
	self:raw(char(unpack(t)))
end

function W:u8(v)  self:uint(v, 1) end
function W:u16(v) self:uint(v, 2) end
function W:u32(v) self:uint(v, 4) end
function W:i32(v) self:uint(v < 0 and v + 4294967296 or v, 4) end
function W:u64(v) self:uint(v, 8) end  -- exact up to 2^53; SteamIDs are filled in by the DLL

-- IEEE 754 encode; bits = 32 or 64.
local function pack_float(x, bits)
	local ebits, mbits = bits == 32 and 8 or 11, bits == 32 and 23 or 52
	local bias = 2 ^ (ebits - 1) - 1
	local sign = (x < 0 or 1 / x < 0) and 1 or 0
	x = math.abs(x)
	local e, m
	if x ~= x then
		e, m = 2 ^ ebits - 1, 1
	elseif x == math.huge then
		e, m = 2 ^ ebits - 1, 0
	elseif x == 0 then
		e, m = 0, 0
	else
		local fm, fe = frexp(x)  -- x = fm * 2^fe, fm in [0.5, 1)
		e = fe - 1 + bias
		if e <= 0 then  -- subnormal
			m = floor(x / 2 ^ (1 - bias - mbits) + 0.5)
			e = 0
		else
			m = floor((fm * 2 - 1) * 2 ^ mbits + 0.5)
			if m == 2 ^ mbits then m, e = 0, e + 1 end
			if e >= 2 ^ ebits - 1 then e, m = 2 ^ ebits - 1, 0 end
		end
	end
	return sign, e, m, mbits
end

function W:f32(x)
	local s, e, m = pack_float(x, 32)
	self:u32(s * 2 ^ 31 + e * 2 ^ 23 + m)
end

function W:f64(x)
	local s, e, m = pack_float(x, 64)
	self:u32(m % 2 ^ 32)
	self:u32(s * 2 ^ 31 + e * 2 ^ 20 + floor(m / 2 ^ 32))
end

function W:cstr(s) self:raw(s) self:raw("\0") end
function W:lstr(s) self:u16(#s) self:raw(s) end

-- Typed value: 01 bool, 02 f64, 03 string, 04 table of typed pairs.
-- Tables are given as { table = { {k, v}, ... } } so order is preserved.
function W:value(v)
	local t = type(v)
	if t == "boolean" then
		self:u8(1) self:u8(v and 1 or 0)
	elseif t == "number" then
		self:u8(2) self:f64(v)
	elseif t == "string" then
		self:u8(3) self:lstr(v)
	else
		self:u8(4) self:u16(#v.table)
		for _, kv in ipairs(v.table) do
			self:value(kv[1])
			self:value(kv[2])
		end
	end
end

-- cstr key, u16 byte length, typed value
function W:sized(key, v)
	local inner = W.new()
	inner:value(v)
	local b = inner:bytes()
	self:cstr(key)
	self:u16(#b)
	self:raw(b)
end

------------------------------------------------------------------ record encoder

-- `p` uses the same field names as tools/xrr_peers.py's JSON.
function encode_peer(p)
	local w = W.new()
	w:cstr(p.name)
	w:u64(p.steamid)
	w:cstr(p.faction)
	w:cstr(p.visual)
	w:cstr(p.outfit)
	w:cstr(p.helmet)
	w:cstr(p.pda)
	w:cstr(p.torch)
	w:cstr(p.active_weapon)
	w:u32(p.active_slot)
	w:cstr(p.level)
	for i = 1, 3 do w:f32(p.position[i]) end
	for i = 1, 2 do w:f32(p.unk_angles[i]) end
	w:f32(p.health)
	w:u32(p.unk_u32)
	w:u32(p.money)
	for i = 1, 4 do w:cstr(p.quick_slots[i]) end
	w:u8(p.unk_u8)

	w:u16(#p.items)
	for _, it in ipairs(p.items) do
		w:u32(it.id)
		w:cstr(it.section)
		w:u16(it.count)
		w:f32(it.condition)
		w:u32(it.ammo_in_mag)
		w:u8(it.slot)
		w:u8(it.place)
		w:u8(it.uses)
		w:u8(it.unk_u8b)
		if it.data then
			local inner = W.new()
			inner:u16(#it.data)
			for _, kv in ipairs(it.data) do
				inner:lstr(kv[1])
				inner:value(kv[2])
			end
			local b = inner:bytes()
			w:u8(1) w:u16(#b) w:raw(b)
		else
			w:u8(0)
		end
		w:u16(it.unk_tail)
	end

	w:i32(p.reputation)
	w:i32(p.rank)
	w:u16(#p.faction_goodwill)
	for _, g in ipairs(p.faction_goodwill) do w:u8(g[1]) w:i32(g[2]) end
	w:u16(#p.npc_relations)
	for _, g in ipairs(p.npc_relations) do w:u16(g[1]) w:i32(g[2]) end

	w:cstr(p.stats)
	w:cstr(p.needs)
	w:u8(p.unk_u8_flags)
	w:u16(#p.flags)
	for _, kv in ipairs(p.flags) do w:cstr(kv[1]) w:cstr(kv[2]) end
	w:u16(#p.limbs)
	for _, kv in ipairs(p.limbs) do w:sized(kv[1], kv[2]) end
	w:u16(#p.m_data)
	for _, kv in ipairs(p.m_data) do w:sized(kv[1], kv[2]) end
	w:u64(p.game_times[1])
	w:u64(p.game_times[2])
	return w:bytes()
end

------------------------------------------------------------------ collecting the live actor

-- Native Lua value -> typed form; nil for anything the format can't hold.
local function to_typed(v, depth)
	local t = type(v)
	if t == "boolean" or t == "number" or t == "string" then return v end
	if t == "userdata" and utils_data and utils_data.CTime_to_table then
		local ok, tbl = pcall(utils_data.CTime_to_table, v)
		if ok and tbl then
			return { table = { { "__xrr_ctime", to_typed(tbl, MAX_DEPTH) } } }
		end
		return nil
	end
	if t ~= "table" or depth <= 0 then return nil end
	local out = {}
	for k, sub in pairs(v) do
		local tk, tv = to_typed(k, 0), to_typed(sub, depth - 1)
		if tk ~= nil and tv ~= nil and type(k) ~= "table" then
			out[#out + 1] = { tk, tv }
		end
	end
	return { table = out }
end

local function section_in_slot(slot)
	local item = db.actor:item_in_slot(slot)
	return item and item:section() or ""
end

local function community_indices()
	-- game_relations.communities is "name, index, name, index, ..."
	local map = {}
	local list = ini_sys:r_string_ex("game_relations", "communities") or ""
	local name
	for tok in list:gmatch("[^,%s]+") do
		if name then
			map[name] = tonumber(tok)
			name = nil
		else
			name = tok
		end
	end
	return map
end

local function collect_item(item, slots, mdata_keys, m)
	local id = item:id()
	local place, slot = PLACE_RUCK, 0
	if slots[id] then
		place, slot = PLACE_SLOT, slots[id]
	elseif db.actor:is_on_belt(item) then
		place = PLACE_BELT
	end

	local count = 1
	if IsAmmo(item) then count = item:ammo_get_count() end

	local mag = 0
	if IsWeapon(item) and item.get_ammo_in_magazine then mag = item:get_ammo_in_magazine() or 0 end

	local uses = 0
	if item.get_remaining_uses then
		local ok, n = pcall(item.get_remaining_uses, item)
		if ok and n then uses = n end
	end

	-- Per-item m_data riders xrRazom declares (xrr_item_mdata.manifest).
	local riders = {}
	for _, key in ipairs(mdata_keys) do
		local tbl = m[key]
		if type(tbl) == "table" and tbl[id] ~= nil then
			local v = to_typed(tbl[id], MAX_DEPTH)
			if v ~= nil then riders[#riders + 1] = { key, v } end
		end
	end
	local data = {}
	local parts = se_load_var and se_load_var(id, nil, "parts")
	if type(parts) == "table" then data[#data + 1] = { "parts", to_typed(parts, MAX_DEPTH) } end
	data[#data + 1] = { "m_data", { table = riders } }

	return {
		id = id, section = item:section(), count = count, condition = item:condition(),
		ammo_in_mag = mag, slot = slot, place = place, uses = uses, unk_u8b = 0,
		data = data, unk_tail = 0,
	}
end

function collect_peer()
	local actor = db.actor
	local m = alife_storage_manager.get_state()

	local slots = {}
	for s = 1, 13 do
		local item = actor:item_in_slot(s)
		if item then slots[item:id()] = s end
	end

	local item_keys = {}
	if xrr_item_mdata and xrr_item_mdata.manifest then
		for _, d in ipairs(xrr_item_mdata.manifest) do item_keys[#item_keys + 1] = d.key end
	end
	local items = {}
	actor:iterate_inventory(function(_, item)
		items[#items + 1] = collect_item(item, slots, item_keys, m)
	end, actor)

	local goodwill = {}
	local idx = community_indices()
	for comm, i in pairs(idx) do
		local gw = relation_registry.community_goodwill(comm, actor:id())
		if gw and gw ~= 0 then goodwill[#goodwill + 1] = { i, gw } end
	end
	table.sort(goodwill, function(a, b) return a[1] < b[1] end)

	local limbs = {}
	for _, prefix in ipairs({ "health.", "timedhp." }) do
		for _, limb in ipairs(LIMBS) do
			local v = utils_obj.load_var(actor, prefix .. limb)
			if type(v) == "number" then limbs[#limbs + 1] = { prefix .. limb, v } end
		end
	end

	-- Peer-owned m_data keys, as xrRazom carries them (xrr_peer_mdata.manifest).
	SendScriptCallback("save_state", m)
	local mdata = {}
	if xrr_peer_mdata and xrr_peer_mdata.manifest then
		for _, key in ipairs(xrr_peer_mdata.manifest) do
			local v = m[key]
			local subs = xrr_peer_mdata.sub_filter and xrr_peer_mdata.sub_filter[key]
			if v ~= nil and subs and type(v) == "table" then
				local f = {}
				for _, sk in ipairs(subs) do f[sk] = v[sk] end
				v = f
			end
			local tv = v ~= nil and to_typed(v, MAX_DEPTH) or nil
			if tv ~= nil then mdata[#mdata + 1] = { key, tv } end
		end
	end

	local active = actor:active_item()
	local pos = actor:position()
	local heading = actor:direction():getH()

	return {
		name = get_console_cmd(0, "xrr_player_name") or "",
		steamid = 0,  -- filled in by savesync.dll
		faction = get_actor_true_community(),
		visual = actor:get_visual_name() or "",
		outfit = section_in_slot(SLOT_OUTFIT),
		helmet = section_in_slot(SLOT_HELMET),
		pda = section_in_slot(SLOT_PDA),
		torch = section_in_slot(SLOT_TORCH),
		active_weapon = active and active:section() or "",
		active_slot = actor:active_slot(),
		level = level.name(),
		position = { pos.x, pos.y, pos.z },
		unk_angles = { heading, heading },
		health = actor.health,
		unk_u32 = 0,
		money = actor:money(),
		quick_slots = {
			get_console_cmd(1, "slot_0") or "", get_console_cmd(1, "slot_1") or "",
			get_console_cmd(1, "slot_2") or "", get_console_cmd(1, "slot_3") or "",
		},
		unk_u8 = 1,
		items = items,
		reputation = actor:character_reputation(),
		rank = actor:character_rank(),
		faction_goodwill = goodwill,
		npc_relations = {},
		stats = xrr_net_client and xrr_net_client.xrr_collect_stats_blob() or "",
		needs = xrr_net_client and xrr_net_client.xrr_collect_condition_blob() or "",
		unk_u8_flags = 0,
		flags = {},
		limbs = limbs,
		m_data = mdata,
		game_times = { 0, 0 },  -- filled in by savesync.dll from the other records
	}
end

------------------------------------------------------------------ export on save

local function new_save_id()
	return string.format("%d-%d", os.time(), math.random(1, 1e9))
end

local function export_path()
	return getFS():update_path("$app_data_root$", "") .. EXPORT_FILE
end

local exporting = false

local function on_save_state(m)
	-- Clients never write saves, and collect_peer re-fires save_state itself.
	if exporting or not db.actor then return end
	if XrrIsClient and XrrIsClient() then return end

	exporting = true
	local ok, err = pcall(function()
		local id = new_save_id()
		local record = encode_peer(collect_peer())
		local w = W.new()
		w:raw("SSHX")
		w:u32(EXPORT_FORMAT)
		w:lstr(id)
		w:raw(record)
		local f = io.open(export_path(), "wb")
		if not f then error("can't open " .. export_path()) end
		f:write(w:bytes())
		f:close()
		m.savesync_id = id
		printf("[savesync] exported host character (%d bytes, id %s)", #record, id)
	end)
	exporting = false
	if not ok then printe("![savesync] host export failed: %s", tostring(err)) end
end

function on_game_start()
	RegisterScriptCallback("save_state", on_save_state)
end
